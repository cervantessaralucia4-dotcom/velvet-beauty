# ============================================================
#  VELVET BEAUTY — Variables de entorno
#  Copia este archivo como  .env  y completa los valores
#  NUNCA subas .env a Git
# ============================================================

# ── Base de datos (Aiven MySQL) ───────────────────────────────
DB_HOST=your-mysql-host.aivencloud.com
DB_PORT=14256
DB_NAME=velvet_beauty
DB_USER=avnadmin
DB_PASS=your_password_here
DB_SSL_CA=/path/to/ca.pem        # Descarga el cert CA desde Aiven dashboard

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_una_cadena_muy_larga_y_aleatoria_min_32_chars

# ── App ────────────────────────────────────────────────────────
APP_ENV=production               # development | production
APP_URL=https://tu-app.onrender.com
FRONTEND_URL=https://tu-frontend.onrender.com
TZ=America/Bogota

# ── Email (PHPMailer — opcional) ───────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu@gmail.com
MAIL_PASS=tu_app_password
MAIL_FROM_NAME=Velvet Beauty
